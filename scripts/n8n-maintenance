#!/bin/bash

set -u

VERSION="2026.10.12.1"

POLICY="/etc/n8n-maintenance/policy.yml"
ACTIONS_DIR="/etc/n8n-maintenance/actions"

ACTION="${1:-}"

fail() {
    echo "===MAINTENANCE_RESULT==="
    echo "STATUS=DENIED"
    echo "REASON=$1"
    exit 1
}

error() {
    echo "===MAINTENANCE_RESULT==="
    echo "STATUS=ERROR"
    echo "REASON=$1"
    exit 2
}

#
# Validation
#

[ -d "$ACTIONS_DIR" ] ||
    fail "Actions directory not found"

[ -f "$POLICY" ] ||
    fail "Policy file not found"

[ -n "$ACTION" ] ||
    fail "No action supplied"

SCRIPT="${ACTIONS_DIR}/${ACTION}.sh"

[ -f "$SCRIPT" ] ||
    fail "Unknown action: $ACTION"

[ -x "$SCRIPT" ] ||
    fail "Action is not executable: $ACTION"

#
# Policy validation
#

POLICY_ENABLED=$(
    yq -r '.policy.enabled // false' "$POLICY"
)

[ "$POLICY_ENABLED" = "true" ] ||
    fail "Maintenance policy disabled"

ACTION_ENABLED=$(
    yq -r ".allowed_actions.${ACTION}.enabled // false" "$POLICY"
)

[ "$ACTION_ENABLED" = "true" ] ||
    fail "Action '$ACTION' disabled"

#
# Start execution
#

echo "===MAINTENANCE_STARTED==="
echo "HOSTNAME=$(hostname)"
echo "VERSION=${VERSION}"
echo "ACTION=${ACTION}"
echo "STARTED_AT=$(date -Iseconds)"

#
# Execute action
#

exec bash "$SCRIPT"
