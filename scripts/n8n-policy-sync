#!/bin/bash

set -u

URL="https://raw.githubusercontent.com/xxcbzxx/automation-maintenance/main/command.yml"

POLICY_DIR="/etc/n8n-maintenance"
POLICY_FILE="${POLICY_DIR}/policy.yml"
TEMP_FILE="${POLICY_DIR}/policy.yml.tmp"

fail() {
    echo "STATUS=ERROR"
    echo "REASON=$1"
    rm -f "$TEMP_FILE"
    exit 1
}

mkdir -p "$POLICY_DIR"

echo "===POLICY_SYNC_STARTED==="
echo "HOSTNAME=$(hostname)"
echo "STARTED_AT=$(date -Iseconds)"

# Download to temporary file first.
curl \
    -fsSL \
    --connect-timeout 10 \
    --max-time 30 \
    "${URL}?$(date +%s)" \
    -o "$TEMP_FILE" ||
    fail "Policy download failed"

# Make sure the file is not empty.
[ -s "$TEMP_FILE" ] ||
    fail "Downloaded policy is empty"

# Make sure YAML can actually be parsed.
yq '.' "$TEMP_FILE" >/dev/null 2>&1 ||
    fail "Downloaded policy contains invalid YAML"

# Validate required values.
SCHEMA_VERSION=$(
    yq -r '.schema_version // empty' "$TEMP_FILE"
)

POLICY_ENABLED=$(
    yq -r '.policy.enabled // empty' "$TEMP_FILE"
)

[ "$SCHEMA_VERSION" = "1" ] ||
    fail "Unsupported or missing schema_version"

case "$POLICY_ENABLED" in
    true|false)
        ;;
    *)
        fail "Invalid or missing*policy.enabled"
        ;;
esac

#*Atomically replace the previous kn*wn-good policy.
chown root:root "$TEMP_FILE"
chmod 0644 "$TEMP_FILE"
mv -f "$TEMP_FILE" "$POLICY_FILE"
echo "===POLICY_SYNC_RESULT==="
echo "STATUS=SUCCESS"
echo "SCHEMA_VERSION=$SCHEMA_VERSION"
echo "POLICY_ENABLED=$POLICY_ENABLED"
echo "FINISHED_AT=$(date -Iseconds)"
